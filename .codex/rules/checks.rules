# This repository's recurring checks, alongside init's generic symphony.rules. A matching
# command runs outside the sandbox so its recorder can keep shared board state. No writable
# directory is added to the workspace sandbox. Run one recipe with the inherited session:
# --one rejects a second recipe before execution, and -- ends just's option parsing. Prefix
# matches can still include invalid extra words: the installed just parser refuses those.
prefix_rule(
    pattern=["just", "--one", "--", ["fmt", "lint-rs", "test-rs", "client-lint", "client-check", "client-update", "symphony-ui-dist", "settings-check", "crates-check", "docs-check"]],
    decision="allow",
    justification="Run this repository's named build and check recipes with their recorder",
    match=[
        "just --one -- fmt",
        "just --one -- lint-rs",
        "just --one -- test-rs -p symphony-board --lib cli::attach",
        "just --one -- client-lint",
        "just --one -- client-check",
        "just --one -- client-update",
        "just --one -- symphony-ui-dist",
        "just --one -- settings-check",
        "just --one -- crates-check",
        "just --one -- docs-check",
    ],
    not_match=[
        "just test-rs-extra",
        "just arbitrary-command",
        "just _lint-rs",
        "just verify",
        "just release",
        "just symphony --shared",
        "just symphony-cli serve",
        "just symphony-cli init --root .",
        "just --justfile /tmp/other.just test-rs",
        "just --working-directory /tmp test-rs",
        "TASKS_SESSION=worker just test-rs",
        "TASKS_TASK=tools/example just lint-rs",
        "env JUST_JUSTFILE=/tmp/other.just just lint-rs",
        "sh -c 'just lint-rs'",
        "tools/record.sh test arbitrary sh -c arbitrary",
        "tools/cargo.sh test",
        "just lint-rs",
        "just lint-rs release",
        "just lint-rs symphony",
        "just lint-rs --justfile /tmp/other.just",
        "just lint-rs --command sh -c arbitrary",
        "just --one lint-rs",
        "just --one -- release",
        "just --one -- symphony --shared",
        "just --one -- --justfile /tmp/other.just lint-rs",
        "just --one -- symphony-cli docs-audit --check",
        "just --one -- symphony-cli status --lint",
        "just --one -- symphony-cli status --lint --tidy",
    ],
)
