{
  "name": "symphony-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The Symphony's web client: React and TypeScript, built by Vite into the distribution the server embeds.",
  "engines": {
    "node": "26.13.1",
    "npm": "11.20.0"
  },
  "scripts": {
    "build": "NODE_ENV=production vite build",
    "dev": "node --disable-warning=ExperimentalWarning dev.ts",
    "lint": "biome ci --error-on-warnings . && tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "minify": "node --disable-warning=ExperimentalWarning shell/minify.ts",
    "report": "node report.ts",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
