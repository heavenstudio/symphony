#!/bin/bash
# `cargo symphony-ui dist OUT`, `cargo symphony-ui dev PORT`, `cargo symphony-ui clippy` and `cargo symphony-ui size`: the client's wasm32 builds as a cargo
# subcommand, so they run through the workspace Cargo entrypoint like any cargo command: in the
# tree's own build folder, its CARGO_TARGET_DIR. Cargo finds this on PATH by its name and runs it
# as `cargo-symphony-ui symphony-ui ARGS`; the justfile's recipes put apps/symphony-ui/bin/ on PATH.
#
#     dist OUT   the web release build into OUT/public (bundle.sh), OUT named from where cargo runs
#                (`just symphony-ui-dist`)
#     clippy     clippy for wasm32 over the browser-only code (src/live.rs, platform::Browser) and the
#                size probes (probes/), every
#                warning an error (`just lint-rs`); the host's clippy never compiles that code
#     dev PORT   an owned loopback API and dx serve, with isolated incremental artifacts
#     size OUT NAME...
#                a page kind or a size probe (probes/) built as the release builds it, its gzip
#                bytes, and a named copy for examples/wasm_size.rs (probes/size.sh)
#
# Release and clippy first clean another tree's wasm32 build of this workspace's crates (wasm-fresh.sh). Tests:
# tests/wasm_build.rs.
set -euo pipefail

here="$(cd "$(dirname "$0")/.." && pwd)"
if [ "${1:-}" = symphony-ui ]; then
    shift
fi
case "${1:-}" in
dev)
    exec bash "$here/dev.sh" "${2:-0}" "${3:-}"
    ;;
dist)
    exec bash "$here/bundle.sh" "${2:?usage: cargo symphony-ui dist OUT [KIND] [OPT]}" "${3:-all}" "${4:-z}"
    ;;
clippy)
    bash "$here/wasm-fresh.sh"
    cd "$here/../.."
    # Every shipped configuration must compile on its own. The union of page features hides
    # unused imports and missing cfg branches, and does not compile the deferred panel at all.
    for kind in board tasks docs review queue panel; do
        "${CARGO:-cargo}" clippy -p symphony-ui --target wasm32-unknown-unknown --lib --bins --locked \
            --no-default-features --features "web,page-$kind" -- -D warnings
    done
    "${CARGO:-cargo}" clippy -p symphony-ui --target wasm32-unknown-unknown --bin symphony-ui-dev --locked \
        --no-default-features --features web,devtools -- -D warnings
    "${CARGO:-cargo}" clippy -p symphony-ui --target wasm32-unknown-unknown --bin floor_dioxus --bin floor_websys \
        --bin entry_websys --locked --no-default-features --features web,size-probe -- -D warnings
    ;;
size)
    shift
    exec bash "$here/probes/size.sh" "$@"
    ;;
*)
    echo "usage: cargo symphony-ui dist OUT | cargo symphony-ui dev [PORT] | cargo symphony-ui clippy | cargo symphony-ui size OUT NAME..." >&2
    exit 2
    ;;
esac
